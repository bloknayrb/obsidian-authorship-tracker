{
  // Typechecks the tests and the mock, with "obsidian" resolved to the in-memory
  // fake via the paths override below.
  //
  // This is NOT a substitute for tsconfig.json, and neither subsumes the other:
  //   * tsconfig.json compiles main.ts against the REAL obsidian.d.ts, so it
  //     catches main.ts drifting from the actual API. It never sees the mock.
  //   * this config compiles main.ts against the MOCK, so it catches the tests
  //     and the mock drifting from main.ts. It never sees the real .d.ts.
  //   * test/mock-conformance.ts (compiled by tsconfig.json) is the only place
  //     the mock is compared against the real API.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": { "obsidian": ["./test/obsidian-mock.ts"] }
  },
  "include": ["main.ts", "src/**/*.ts", "test/**/*.ts"],
  // `extends` REPLACES rather than merges `exclude`. Omitting it here would
  // inherit the base config's exclusion of test files and this step would
  // silently check nothing.
  "exclude": ["node_modules"]
}
